				local img=Instance.new("ImageLabel",sf)
				img.Size,img.Position,img.BackgroundTransparency,img.Image,img.ScaleType=UDim2.new(0,sz-8,0,sz-8),UDim2.new(0,4,0,4),1,ic,Enum.ScaleType.Fit
				if isGun(v.Name) then
