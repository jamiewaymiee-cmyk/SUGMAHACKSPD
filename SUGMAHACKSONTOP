    local l = Instance.new("TextLabel", parent)
    l.Size, l.Position = UDim2.new(1, -2, 0, 13), UDim2.new(0, 0, 0, 0)
    l.BackgroundTransparency, l.TextColor3 = 1, Color3.fromRGB(255, 220, 50)
    l.Font, l.TextSize, l.Text = Enum.Font.GothamBold, 10, txt
    l.TextXAlignment, l.TextYAlignment, l.TextStrokeTransparency, l.ZIndex = Enum.TextXAlignment.Right, Enum.TextYAlignment.Top, 0, 5
end

local function getAttachIcons(inv)
    local icons = {}
    local att = inv:FindFirstChild("Attachments")
    if att then
        for _, a in pairs(att:GetChildren()) do
            local s = a:GetAttribute("Slot")
            if s == "Sight" or s == "Magazine" or s == "Extra" or s == "Barrel" or s == "UnderBarrel" then
                local ic = getIcon(a.Name)
                if ic then
                    table.insert(icons, {icon = ic, name = a.Name})
                end
            end
        end
    end
    return icons
end

