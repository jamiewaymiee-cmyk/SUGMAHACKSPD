	local py=math.clamp(mp.Y,0,cam.ViewportSize.Y-ph-4)
	local panel=Instance.new("Frame",sg)
	panel.Size,panel.Position,panel.BackgroundColor3,panel.BackgroundTransparency,panel.BorderSizePixel=UDim2.new(0,pw,0,ph),UDim2.new(0,px,0,py),Color3.fromRGB(15,15,15),0.1,0
	local pc=Instance.new("UICorner",panel) pc.CornerRadius=UDim.new(0,10)
	local st=Instance.new("UIStroke",panel) st.Color,st.Thickness,st.Transparency=Color3.fromRGB(55,55,55),1,0
	local ti=Instance.new("TextLabel",panel)
	ti.Size,ti.Position,ti.BackgroundTransparency,ti.TextColor3,ti.Font,ti.TextSize,ti.Text,ti.TextXAlignment=UDim2.new(1,-8,0,30),UDim2.new(0,8,0,0),1,Color3.fromRGB(255,255,255),Enum.Font.GothamBold,13,"Viewing "..tName.." | Inventory",Enum.TextXAlignment.Left
	local cy=30
	local function drawSec(lbl,items,isEq)
		if #items==0 then return end
		local lb=Instance.new("TextLabel",panel)
		lb.Size,lb.Position,lb.BackgroundTransparency,lb.TextColor3,lb.Font,lb.TextSize,lb.Text,lb.TextXAlignment=UDim2.new(1,-8,0,18),UDim2.new(0,8,0,cy),1,Color3.fromRGB(155,155,155),Enum.Font.GothamBold,11,lbl,Enum.TextXAlignment.Left
		cy=cy+18
		local col,rowY=0,cy
		for _,entry in items do
			local v=isEq and entry.item or entry
			local ic=getIcon(v.Name)
			local fx=pad/2+col*(sz+pad)
			local sf=Instance.new("Frame",panel)
			sf.Size,sf.Position,sf.BackgroundColor3,sf.BackgroundTransparency,sf.BorderSizePixel=UDim2.new(0,sz,0,sz),UDim2.new(0,fx,0,rowY),Color3.fromRGB(32,32,32),0.2,0
			local sfc=Instance.new("UICorner",sf) sfc.CornerRadius=UDim.new(0,8)
