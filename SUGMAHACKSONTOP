				nl.Size,nl.Position,nl.BackgroundTransparency,nl.TextColor3,nl.Font,nl.TextSize,nl.Text,nl.TextWrapped,nl.TextXAlignment,nl.TextYAlignment=UDim2.new(1,-2,1,-2),UDim2.new(0,1,0,1),1,Color3.fromRGB(175,175,175),Enum.Font.Gotham,9,v.Name,true,Enum.TextXAlignment.Center,Enum.TextYAlignment.Center
