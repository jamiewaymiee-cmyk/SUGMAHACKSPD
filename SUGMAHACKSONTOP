local function ensureConfigFolder()
    if UNCFeatures.makefolder then
        pcall(function()
            if not isfolder(Config.ConfigFolder) then
                makefolder(Config.ConfigFolder)
            end
        end)
    end
end

local function getConfigList()
    local configs = {}
    if UNCFeatures.listfiles then
        ensureConfigFolder()
        local success, files = pcall(function()
            return listfiles(Config.ConfigFolder)
        end)
        
        if success and files then
            for _, file in pairs(files) do
                local name = file:match("([^/\\]+)%.json$")
                if name then
                    table.insert(configs, name)
                end
            end
        end
    end
    
    if #configs == 0 then
        table.insert(configs, "Default")
    end
    
    table.sort(configs)
    return configs
end

local function saveConfig(name)
    if not UNCFeatures.writefile then
        notify("Error", "Your executor does not support writefile", 3)
        return
    end
    
    ensureConfigFolder()
    local configName = name or Config.CurrentConfig
    local path = Config.ConfigFolder .. "/" .. configName .. ".json"
    
    local configData = {
        Flags = Lib.Flags,
        SilentAim = silentAim,
        Timestamp = os.time()
    }
    
    local success = pcall(function()
        writefile(path, HttpService:JSONEncode(configData))
    end)
    
    if success then
        Config.LastConfig = configName
        notify("Config", "Saved: " .. configName, 2)
        return true
    else
        notify("Error", "Failed to save config", 3)
        return false
    end
end

local function loadConfig(name)
    if not UNCFeatures.readfile or not UNCFeatures.isfile then
        notify("Error", "Your executor does not support file operations", 3)
        return
    end
    
    local configName = name or Config.CurrentConfig
    local path = Config.ConfigFolder .. "/" .. configName .. ".json"
    
    if not isfile(path) then
        notify("Error", "Config not found: " .. configName, 3)
        return
    end
    
    local success, data = pcall(function()
        return HttpService:JSONDecode(readfile(path))
    end)
    
    if success and data then
        if data.Flags then
            for k, v in pairs(data.Flags) do
                Lib.Flags[k] = v
            end
        end
        
        if data.SilentAim then
            for k, v in pairs(data.SilentAim) do
                if silentAim[k] ~= nil then
                    silentAim[k] = v
                end
            end
        end
        
        Lib:Update()
        Config.LastConfig = configName
        notify("Config", "Loaded: " .. configName, 2)
        return true
    else
        notify("Error", "Failed to parse config", 3)
        return false
    end
end

local function deleteConfig(name)
    if not UNCFeatures.delfile then
        notify("Error", "Your executor does not support delfile", 3)
        return
    end
    
    local configName = name or Config.CurrentConfig
    if configName == "Default" then
        notify("Error", "Cannot delete Default config", 3)
        return
    end
    
    local path = Config.ConfigFolder .. "/" .. configName .. ".json"
    
    if not isfile(path) then
        notify("Error", "Config not found: " .. configName, 3)
        return
    end
    
    local success = pcall(function()
        delfile(path)
    end)
    
    if success then
        notify("Config", "Deleted: " .. configName, 2)
        return true
    else
        notify("Error", "Failed to delete config", 3)
        return false
    end
end

local function isAlive(char)
    return char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0
end

local function isVisible(origin, target, ...)
    local ignore = {cam, ...}
    if isAlive(lplr.Character) then table.insert(ignore, lplr.Character) end
    
    local ray = Ray.new(origin, target.Position - origin)
    local hit = Work:FindPartOnRayWithIgnoreList(ray, ignore, false, true)
    return hit and hit:IsDescendantOf(target.Parent)
end

local function getAI()
    local ai = {}
    for _, v in pairs(aiZones:GetChildren()) do
        for _, character in pairs(v:GetChildren()) do
            if character:IsA("Model") and character:FindFirstChild("Humanoid") then
                table.insert(ai, character)
            end
        end
    end
    return ai
end

local function getTarget(fov, hitPart, wallCheck)
    local closest, closestDist = nil, fov or fovR
    local mousePos = UIS:GetMouseLocation()
    
    for _, character in pairs(getAI()) do
        if not isAlive(character) then continue end
        
        local targetPart = character:FindFirstChild(hitPart or aimP)
        if not targetPart then continue end
        
        if wallCheck and not isVisible(cam.CFrame.Position, targetPart) then continue end
        
        local screenPos, onScreen = cam:WorldToViewportPoint(targetPart.Position)
        if not onScreen then continue end
        
        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
        if dist < closestDist then
            closestDist = dist
            closest = targetPart
        end
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player == lplr or not isAlive(player.Character) then continue end
        
        local targetPart = player.Character:FindFirstChild(hitPart or aimP)
        if not targetPart then continue end
        
        if wallCheck and not isVisible(cam.CFrame.Position, targetPart) then continue end
        
        local screenPos, onScreen = cam:WorldToViewportPoint(targetPart.Position)
        if not onScreen then continue end
        
        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
        if dist < closestDist then
            closestDist = dist
            closest = targetPart
        end
    end
    
    return closest
end

if silentAimAvailable then
    local function solveQuadratic(A, B, C)
        local disc = B^2 - 4*A*C
        if disc < 0 then return nil, nil end
        
        local sqrtDisc = math.sqrt(disc)
        return (-B - sqrtDisc) / (2*A), (-B + sqrtDisc) / (2*A)
    end
    
    local function getBallisticTime(dir, grav, speed)
        local r1, r2 = solveQuadratic(
            grav:Dot(grav) / 4,
            grav:Dot(dir) - speed^2,
            dir:Dot(dir)
        )
        
        if r1 and r2 then
            if r1 > 0 and r1 < r2 then return math.sqrt(r1)
            elseif r2 > 0 and r2 < r1 then return math.sqrt(r2)
            end
        end
        return 0
    end
    
    local function projectileDrop(origin, target, speed, accel)
        local gravity = Vector3.yAxis * (accel * 2)
        local time = getBallisticTime(target - origin, gravity, speed)
        return 0.5 * gravity * time^2
    end
    
    local function predict(target, origin, speed, accel)
        local gravity = Vector3.yAxis * (accel * 2)
        local time = getBallisticTime(target.Position - origin, gravity, speed)
        return target.Position + (target.Velocity * time)
    end
    
    oldBullet = hookfunction(bulletModule.CreateBullet, function(...)
        local args = {...}
        
        if not silentAim.Enabled then
            return oldBullet(...)
        end
        
        local targetFOV = silentAim.SharedFOV and fovR or silentAim.FOV
        local target = getTarget(targetFOV, silentAim.HitPart, silentAim.WallCheck)
        
        if target then
            local aimPart = args[4]
            local ammoType = args[7]
            
            if ammoType then
                local bullet = RS:FindFirstChild("AmmoTypes") and RS.AmmoTypes:FindFirstChild(ammoType)
                
                if bullet and aimPart then
                    local accel = bullet:GetAttribute("ProjectileDrop")
                    local speed = bullet:GetAttribute("MuzzleVelocity")
                    
                    if accel and speed then
                        bullet:SetAttribute("Drag", 0)
                        
                        local targetPos = silentAim.Prediction and predict(target, aimPart.Position, speed, accel) or target.Position
                        local drop = projectileDrop(aimPart.Position, targetPos, speed, accel)
                        
                        args[4] = {CFrame = CFrame.new(aimPart.Position, targetPos + drop)}
                    end
                end
            end
        end
        
        return oldBullet(unpack(args))
    end)
    
    notify("Silent Aim", "Module loaded successfully!", 3)
else
    if not UNCFeatures.hookfunction then
        notify("Silent Aim", "Unavailable: hookfunction not supported", 5)
    elseif not UNCFeatures.require then
        notify("Silent Aim", "Unavailable: require not supported", 5)
    else
        notify("Silent Aim", "Unavailable: Bullet module not found", 5)
    end
end

local function clrEspEntry(m)
    if not espS[m] then return end
    
    pcall(function() if espS[m].B then espS[m].B:Destroy() end end)
    pcall(function() if espS[m].H then espS[m].H:Destroy() end end)
    if UNCFeatures.Drawing then
        pcall(function() if espS[m].BX then espS[m].BX:Remove() end end)
        pcall(function() if espS[m].SK then for _, l in pairs(espS[m].SK) do l:Remove() end end end)
        pcall(function() if espS[m].VL then espS[m].VL:Remove() end end)
        pcall(function() if espS[m].LV then espS[m].LV:Remove() end end)
    end
    
    espS[m] = nil
    espAIHealth[m] = nil
end

local function clrEsp()
    for m in pairs(espS) do
        clrEspEntry(m)
    end
    espS = {}
    espAIHealth = {}
end

local function clrDrw()
    for _, d in pairs(iDrw) do
        if typeof(d) == "Instance" then
            pcall(function() d:Destroy() end)
        elseif d and d.Remove then
            pcall(function() d:Remove() end)
        end
    end
    iDrw = {}
    currentInvTarget = nil
end

