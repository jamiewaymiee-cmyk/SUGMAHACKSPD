-- INVENTORY FUNCTIONS (READDED)
local function getStack(item)
    local amt = item:GetAttribute("Amount") or item:GetAttribute("Count") or item:GetAttribute("Quantity") or item:GetAttribute("Stack")
    if not amt then
        for _, a in pairs({"amount", "count", "quantity", "stack", "stackSize", "StackSize", "stackCount"}) do
            local v = item:GetAttribute(a)
            if v and type(v) == "number" then
                amt = v
                break
            end
        end
    end
    return (type(amt) == "number" and amt > 0) and amt or 1
end

local function fmtItm(i)
    local a = getStack(i)
    return a > 1 and i.Name .. " [" .. a .. "x]" or i.Name
end

local function fmtWep(w)
    local t, l, f = w.Name, {}, w:FindFirstChild("Attachments")
    if f then
        for _, a in pairs(f:GetChildren()) do
            local s = a:GetAttribute("Slot")
            if s == "Sight" or s == "Magazine" or s == "Extra" then
                local n = a.Name
                if s == "Magazine" then
                    n = n .. "(" .. (a:GetAttribute("LoadedAmmo") or 0) .. ")"
                end
                table.insert(l, n)
            end
        end
    end
    return #l > 0 and t .. " [" .. table.concat(l, ", ") .. "]" or t .. " [None]"
end

local function isGun(n)
    local i = iList:FindFirstChild(n)
    if i then
        local ip = i:FindFirstChild("ItemProperties")
        if ip and ip:GetAttribute("ItemType") == "RangedWeapon" then
            return true
        end
    end
    return false
end

local function getIcon(n)
    return iconCache[n]
end

local function buildInvData(pinv)
    local eq, bp = {}, {}
    for _, v in pairs(pinv:GetChildren()) do
        local sl = v:GetAttribute("Slot")
        local ni = v:FindFirstChild("Inventory")
        if sl and priS[sl] then
            table.insert(eq, {item = v, slot = sl})
        else
            table.insert(bp, v)
        end
        if ni then
            for _, k in pairs(ni:GetChildren()) do
                table.insert(bp, k)
            end
        end
    end
    return eq, bp
end

