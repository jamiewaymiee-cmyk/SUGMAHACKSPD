local function upEsp(m, n, c, w)
    local hum = m and m:FindFirstChild("Humanoid")
    local hrp = m and m:FindFirstChild("HumanoidRootPart")
    
    if not m or not hrp or not hum then
        clrEspEntry(m)
        return
    end
    
    if hum.Health <= 0 then
        clrEspEntry(m)
        return
    end
    
    espAIHealth[m] = hum.Health
    
    local myC = lplr.Character
    if not myC or not myC:FindFirstChild("HumanoidRootPart") then return end
    
    if espRandColor then
        c = getRandColor(n)
    end
    
    local d = math.floor((myC.HumanoidRootPart.Position - hrp.Position).Magnitude)
    local hp = math.floor(hum.Health)
    
    if not espS[m] then
        local b = Instance.new("BillboardGui", hrp)
        b.AlwaysOnTop, b.Size, b.StudsOffset = true, UDim2.new(0, 220, 0, 60), Vector3.new(0, 3.5, 0)
        b.Adornee = m:FindFirstChild("Head") or hrp
        
        local l = Instance.new("TextLabel", b)
        l.Size, l.BackgroundTransparency = UDim2.new(1, 0, 1, 0), 1
        l.TextColor3, l.TextStrokeTransparency = c, 0
        l.Font, l.TextSize = Enum.Font.GothamBold, 13
        
        local hl = Instance.new("Highlight", m)
        hl.FillColor, hl.FillTransparency = c, 0.5
        hl.OutlineColor, hl.Adornee = c, m
        
        espS[m] = {B = b, L = l, H = hl}
    end
    
    local e = espS[m]
    e.H.Enabled, e.H.FillColor, e.H.OutlineColor = true, c, c
    
    local wldM = getWldModel(m)
    local txt = ""
    if espNameTag then txt = n end
    if espDist then txt = txt .. (#txt > 0 and " | " or "") .. d .. "m" end
    if w and getHld(m) then txt = txt .. (#txt > 0 and "\n" or "") .. "[" .. getHld(m) .. "]" end
    if w and wldM then txt = txt .. (#txt > 0 and "\n" or "") .. "[W:" .. wldM .. "]" end
    txt = txt .. (#txt > 0 and "\n" or "") .. "HP: " .. hp
    
    e.L.Text, e.L.TextColor3, e.B.Enabled = txt, c, true
    
    if espBox and UNCFeatures.Drawing then
        local vis, x1, y1, x2, y2 = getCharBounds(m)
        if not e.BX then
            local bf = Drawing.new("Square")
            bf.Filled, bf.Thickness, bf.Color, bf.Transparency, bf.Visible = false, 1.5, c, 1, false
            e.BX = bf
        end
        
        if vis then
            local pad = 4
            e.BX.Position = Vector2.new(x1 - pad, y1 - pad)
            e.BX.Size = Vector2.new((x2 - x1) + pad * 2, (y2 - y1) + pad * 2)
            e.BX.Color, e.BX.Visible = c, true
        else
            e.BX.Visible = false
        end
    elseif e.BX then
        e.BX:Remove()
        e.BX = nil
    end
    
    if espSkeleton and UNCFeatures.Drawing then
        if not e.SK then e.SK = {} end
        
        local li = 1
        for _, pair in pairs(SKEL) do
            local p1, p2 = m:FindFirstChild(pair[1]), m:FindFirstChild(pair[2])
            if p1 and p2 then
                local v1, s1 = w2s(p1.Position)
                local v2, s2 = w2s(p2.Position)
                
                if not e.SK[li] then
                    local ln = Drawing.new("Line")
                    ln.Thickness, ln.Color, ln.Transparency, ln.Visible = 1, c, 1, false
                    e.SK[li] = ln
                end
                
                if v1 and v2 then
                    e.SK[li].From, e.SK[li].To, e.SK[li].Color, e.SK[li].Visible = s1, s2, c, true
                else
                    e.SK[li].Visible = false
                end
                li = li + 1
            end
        end
        
        for i = li, #e.SK do
            e.SK[i].Visible = false
        end
    elseif e.SK then
        for _, ln in pairs(e.SK) do
            pcall(function() ln:Remove() end)
        end
        e.SK = nil
    end
    
    if espVelocity and UNCFeatures.Drawing then
        if hrp then
            local vel = hrp.AssemblyLinearVelocity
            if vel.Magnitude > 0.5 then
                local vis2, sp2 = w2s(hrp.Position)
                local _, sp3 = w2s(hrp.Position + vel.Unit * 3)
                
                if vis2 then
                    if not e.VL then
                        local vl = Drawing.new("Line")
                        vl.Thickness, vl.Color, vl.Transparency, vl.Visible = 2, Color3.new(1, 1, 0), 1, false
                        e.VL = vl
                    end
                    e.VL.From, e.VL.To, e.VL.Color, e.VL.Visible = sp2, sp3, Color3.new(1, 1, 0), true
                else
                    if e.VL then e.VL.Visible = false end
                end
            else
                if e.VL then e.VL.Visible = false end
            end
        end
    elseif e.VL then
        pcall(function() e.VL:Remove() end)
        e.VL = nil
    end
    
    if espLookVec and UNCFeatures.Drawing then
        local head = m:FindFirstChild("Head")
        if head then
            local visH, spH = w2s(head.Position)
            local _, spL = w2s(head.Position + head.CFrame.LookVector * 4)
            
            if visH then
                if not e.LV then
                    local lv = Drawing.new("Line")
                    lv.Thickness, lv.Color, lv.Transparency, lv.Visible = 2, c, 1, false
                    e.LV = lv
                end
                e.LV.From, e.LV.To, e.LV.Color, e.LV.Visible = spH, spL, c, true
            else
                if e.LV then e.LV.Visible = false end
            end
        end
    elseif e.LV then
        pcall(function() e.LV:Remove() end)
        e.LV = nil
    end
end

local function isK(f)
    local k = Lib.Flags and Lib.Flags[f]
    if not k then return false end
    if k == "MouseButton1" then return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
    elseif k == "MouseButton2" then return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) end
    local s, e = pcall(function() return Enum.KeyCode[k] end)
    return s and UIS:IsKeyDown(e)
end

