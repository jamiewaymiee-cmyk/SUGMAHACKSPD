            local o = pInv:FindFirstChild(gn)
            if o then
                o:SetAttribute("FireMode", orig.FireMode)
                o:SetAttribute("FireModeIndex", orig.FireModeIndex)
                o:SetAttribute("FireModeIndexS", 1)
            end
        end
        boltOriginals = {}
        notify("OK", "Bolt Actions reverted", 2)
    end
end)

local function getB(p)
    local c, last = game, nil
    for s in p:gmatch("[^.]+") do
        if s == "workspace" then
            c = Work
        elseif c and c:FindFirstChild(s) then
            c = c[s]
        else
            return nil, nil
        end
        last = c
    end
    if last then
        return last:FindFirstChild("Humanoid"), last
    end
    return nil, nil
end

