local function getCharBounds(m)
    local mnX, mnY, mxX, mxY = math.huge, math.huge, -math.huge, -math.huge
    local vis = false
    
    for _, pn in pairs({"Head","UpperTorso","LowerTorso","LeftUpperArm","RightUpperArm","LeftUpperLeg","RightUpperLeg","LeftFoot","RightFoot","LeftHand","RightHand"}) do
        local p = m:FindFirstChild(pn)
        if p then
            local screenPos, onScreen = cam:WorldToViewportPoint(p.Position)
            if onScreen then
                vis = true
                mnX = math.min(mnX, screenPos.X)
                mnY = math.min(mnY, screenPos.Y)
                mxX = math.max(mxX, screenPos.X)
                mxY = math.max(mxY, screenPos.Y)
            end
        end
    end
    
    return vis, mnX, mnY, mxX, mxY
end

