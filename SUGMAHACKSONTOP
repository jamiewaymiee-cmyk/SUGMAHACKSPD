RunS.RenderStepped:Connect(function()
    sens = Lib.Flags.AimSens or 0
    fovR = Lib.Flags.FOVRad or 100
    showF = Lib.Flags.ShowFOV or false
    
    local tVal = Lib.Flags.TimeVal or 12
    
    if fbEn then
