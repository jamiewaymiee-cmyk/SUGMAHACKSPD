local function drawTextInv(pinv,tName)
	clrDrw()
	local mp=UIS:GetMouseLocation()
	local s=Vector2.new(mp.X+20,mp.Y)
	local eq,bp=buildInvData(pinv)
	local eqF,bpF={},{}
	for _,e in eq do table.insert(eqF,{T=(e.slot:find("Back") or e.slot:find("Hip")) and fmtWep(e.item) or fmtItm(e.item),S=e.slot}) end
	for _,v in bp do table.insert(bpF,fmtItm(v)) end
	local y=0
	local function mk(txt,sz,col) local d=Drawing.new("Text") d.Text,d.Size,d.Outline,d.Color,d.Position,d.Visible=txt,sz,true,col,s+Vector2.new(0,y),true table.insert(iDrw,d) y=y+sz+2 end
	mk(tName,18,Color3.new(1,1,1))
	for _,v in eqF do mk("["..v.S.."] "..v.T,15,Color3.new(0,1,1)) end
	y=y+5 mk("BACKPACK",15,Color3.new(1,0.6,0))
	for i=1+iOff,math.min(#bpF,iOff+20) do mk(bpF[i],14,Color3.new(0,1,0)) end
end

local function tacTog(s,b)
	if selDev=="None" then return end
	local g=getHld(lplr.Character) if not g then return end
	local o=pInv:FindFirstChild(g) if not o then return end
	local a=o:FindFirstChild("Attachments") or Instance.new("Folder",o) a.Name="Attachments"
	local e for _,c in a:GetChildren() do if c:GetAttribute("Slot")=="Extra" then e=c break end end
	if s then
		if e then e:SetAttribute("Toggle",true)
		else local r=iList:FindFirstChild(selDev) if r then local n=Instance.new("ObjectValue",a) n.Name,n.Value=selDev,r n:SetAttribute("Slot","Extra") n:SetAttribute("Toggle",true) n:SetAttribute("ScriptAdded",true) end end
	else if e then e:SetAttribute("Toggle",false) end end
	if b then Lib:Notify("OK",s and "Tac Enabled" or "Tac Disabled",2) end
end

local function shouldFreezeHRP()
