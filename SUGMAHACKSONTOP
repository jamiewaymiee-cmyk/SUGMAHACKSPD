local SKEL={{"Head","UpperTorso"},{"UpperTorso","LowerTorso"},{"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},{"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},{"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},{"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"}}

local function getCharBounds(m)
	local mnX,mnY,mxX,mxY=math.huge,math.huge,-math.huge,-math.huge
	local vis=false
	for _,pn in {"Head","UpperTorso","LowerTorso","LeftUpperArm","RightUpperArm","LeftUpperLeg","RightUpperLeg","LeftFoot","RightFoot","LeftHand","RightHand"} do
		local p=m:FindFirstChild(pn)
		if p then local v,sp=w2s(p.Position) if v then vis=true mnX=math.min(mnX,sp.X) mnY=math.min(mnY,sp.Y) mxX=math.max(mxX,sp.X) mxY=math.max(mxY,sp.Y) end end
	end
	return vis,mnX,mnY,mxX,mxY
end

local function upEsp(m,n,c,w)
	if not m or not m:FindFirstChild("HumanoidRootPart") then clrEspEntry(m) return end
	local hum=m:FindFirstChild("Humanoid")
	if not hum or hum.Health<=0 then clrEspEntry(m) return end
	local myC=lplr.Character
	if not myC or not myC:FindFirstChild("HumanoidRootPart") then return end
	if espRandColor then c=getRandColor(n) end
	local d=math.floor((myC.HumanoidRootPart.Position-m.HumanoidRootPart.Position).Magnitude)
	local hp=math.floor(hum.Health)
	if not espS[m] then
		local b=Instance.new("BillboardGui",m.HumanoidRootPart)
		b.AlwaysOnTop,b.Size,b.StudsOffset,b.Adornee=true,UDim2.new(0,220,0,60),Vector3.new(0,3.5,0),m:FindFirstChild("Head") or m.HumanoidRootPart
		local l=Instance.new("TextLabel",b)
		l.Size,l.BackgroundTransparency,l.TextColor3,l.TextStrokeTransparency,l.Font,l.TextSize,l.Text=UDim2.new(1,0,1,0),1,c,0,Enum.Font.GothamBold,13,""
		local hl=Instance.new("Highlight",m)
		hl.FillColor,hl.FillTransparency,hl.OutlineColor,hl.Adornee=c,0.5,c,m
		espS[m]={B=b,L=l,H=hl}
	end
	local e=espS[m]
	e.H.Enabled,e.H.FillColor,e.H.OutlineColor=true,c,c
	local wldM=getWldModel(m)
	local txt="" if espNameTag then txt=n end if espDist then txt=txt..(#txt>0 and " | " or "")..d.."m" end if w and getHld(m) then txt=txt..(#txt>0 and "\n" or "").."["..getHld(m).."]" end if w and wldM then txt=txt..(#txt>0 and "\n" or "").."[W:"..wldM.."]" end txt=txt..(#txt>0 and "\n" or "").."HP: "..hp
	e.L.Text,e.L.TextColor3,e.B.Enabled=txt,c,true
	local vis,x1,y1,x2,y2=getCharBounds(m)
	if espBox then
		if not e.BX then local bf=Drawing.new("Square") bf.Filled,bf.Thickness,bf.Color,bf.Transparency,bf.Visible=false,1.5,c,1,false e.BX=bf end
		if vis then local pad=4 e.BX.Position=Vector2.new(x1-pad,y1-pad) e.BX.Size=Vector2.new((x2-x1)+pad*2,(y2-y1)+pad*2) e.BX.Color,e.BX.Visible=c,true else e.BX.Visible=false end
	elseif e.BX then e.BX:Remove() e.BX=nil end
	if espSkeleton then
		if not e.SK then e.SK={} end
		local li=1
		for _,pair in SKEL do
			local p1,p2=m:FindFirstChild(pair[1]),m:FindFirstChild(pair[2])
			if p1 and p2 then
				local v1,s1=w2s(p1.Position) local v2,s2=w2s(p2.Position)
				if not e.SK[li] then local ln=Drawing.new("Line") ln.Thickness,ln.Color,ln.Transparency,ln.Visible=1,c,1,false e.SK[li]=ln end
				if v1 and v2 then e.SK[li].From,e.SK[li].To,e.SK[li].Color,e.SK[li].Visible=s1,s2,c,true else e.SK[li].Visible=false end
				li=li+1
			end
		end
		for i=li,#e.SK do e.SK[i].Visible=false end
	elseif e.SK then for _,ln in e.SK do pcall(function() ln:Remove() end) end e.SK=nil end
	if espVelocity then
		local hrp=m:FindFirstChild("HumanoidRootPart")
		if hrp then
			local vel=hrp.AssemblyLinearVelocity
			if vel.Magnitude>0.5 then
				local vis2,sp2=w2s(hrp.Position) local _,sp3=w2s(hrp.Position+vel.Unit*3)
				if vis2 then if not e.VL then local vl=Drawing.new("Line") vl.Thickness,vl.Color,vl.Transparency,vl.Visible=2,Color3.new(1,1,0),1,false e.VL=vl end e.VL.From,e.VL.To,e.VL.Color,e.VL.Visible=sp2,sp3,Color3.new(1,1,0),true
				else if e.VL then e.VL.Visible=false end end
			else if e.VL then e.VL.Visible=false end end
		end
	elseif e.VL then pcall(function() e.VL:Remove() end) e.VL=nil end
	if espLookVec then
		local head=m:FindFirstChild("Head")
		if head then
			local visH,spH=w2s(head.Position)
			local _,spL=w2s(head.Position+head.CFrame.LookVector*4)
			if visH then
				if not e.LV then local lv=Drawing.new("Line") lv.Thickness,lv.Color,lv.Transparency,lv.Visible=2,c,1,false e.LV=lv end
				e.LV.From,e.LV.To,e.LV.Color,e.LV.Visible=spH,spL,c,true
			else if e.LV then e.LV.Visible=false end end
		end
	elseif e.LV then pcall(function() e.LV:Remove() end) e.LV=nil end
end

local function buildInvData(pinv)
	local eq,bp={},{}
	for _,v in pinv:GetChildren() do
		local sl=v:GetAttribute("Slot") local ni=v:FindFirstChild("Inventory")
		if sl and priS[sl] then table.insert(eq,{item=v,slot=sl}) else table.insert(bp,v) end
		if ni then for _,k in ni:GetChildren() do table.insert(bp,k) end end
	end
	return eq,bp
end

local function mkBadge(parent,txt) local l=Instance.new("TextLabel",parent) l.Size,l.Position,l.BackgroundTransparency,l.TextColor3,l.Font,l.TextSize,l.Text,l.TextXAlignment,l.TextYAlignment,l.TextStrokeTransparency,l.ZIndex=UDim2.new(1,-2,0,13),UDim2.new(0,0,0,0),1,Color3.fromRGB(255,220,50),Enum.Font.GothamBold,10,txt,Enum.TextXAlignment.Right,Enum.TextYAlignment.Top,0,5 end

local function getAttachIcons(inv)
	local icons={} local att=inv:FindFirstChild("Attachments")
	if att then for _,a in att:GetChildren() do local s=a:GetAttribute("Slot") if s=="Sight" or s=="Magazine" or s=="Extra" or s=="Barrel" or s=="UnderBarrel" then local ic=getIcon(a.Name) if ic then table.insert(icons,{icon=ic,name=a.Name}) end end end end
	return icons
end

local function drawImageInv(pinv,tName)
	clrDrw()
