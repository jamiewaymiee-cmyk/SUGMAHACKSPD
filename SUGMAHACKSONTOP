	if Lib.Flags.TpWalk and lplr.Character and lplr.Character:FindFirstChild("HumanoidRootPart") and lplr.Character:FindFirstChild("Humanoid") then
		local hrp,hum=lplr.Character.HumanoidRootPart,lplr.Character.Humanoid
		if hum.MoveDirection.Magnitude>0 then hrp.CFrame=hrp.CFrame+(hum.MoveDirection*(Lib.Flags.TpWalkSpeed or 0.3)) end
	end
end)

RunS.RenderStepped:Connect(function()
	sens=Lib.Flags.AimSens or 0 fovR=Lib.Flags.FOVRad or 100 showF=Lib.Flags.ShowFOV or false
	local tVal=Lib.Flags.TimeVal or 12
	if fbEn then Light.ClockTime,Light.Brightness,Light.GlobalShadows,Light.Ambient,Light.OutdoorAmbient=14,2,false,Color3.new(1,1,1),Color3.new(1,1,1) else Light.ClockTime,Light.GlobalShadows=tVal,true end
	if noFogEn then Light.FogEnd,Light.FogStart=1e6,1e6 end
	pcall(function() lplr.PlayerGui.NoInsetGui.MainFrame.ScreenEffects.Visible=not nvEn end)
	if Lib.Flags.Speedhack and lplr.Character and lplr.Character:FindFirstChild("Humanoid") then local hum=lplr.Character.Humanoid if hum.WalkSpeed>18.2 then hum.WalkSpeed=0 else hum.WalkSpeed=18 end end
	if Lib.Flags.DynSpeed and lplr.Character and lplr.Character:FindFirstChild("Humanoid") then local ok,st=pcall(function() return lplr.PlayerGui.MainGui.MainFrame.BackpackFrame.CharacterFrame.VitalSigns.Speed.Number.Text end) if ok and st then lplr.Character.Humanoid.WalkSpeed=tonumber(st:gsub("[^%d%.]","")) or 18 end end
	if Lib.Flags.DeadEsp then
		local itms=Work:FindFirstChild("DroppedItems")
		if itms then for _,v in itms:GetChildren() do if v:IsA("Model") and not espD[v] then for _,p in Plrs:GetPlayers() do if v.Name:find(p.Name) then local base=v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart") if base then local b=Instance.new("BillboardGui",base) b.AlwaysOnTop,b.Size,b.StudsOffset=true,UDim2.new(0,200,0,50),Vector3.new(0,2,0) local l=Instance.new("TextLabel",b) l.Size,l.BackgroundTransparency,l.TextColor3,l.TextStrokeTransparency,l.Font,l.TextSize,l.Text=UDim2.new(1,0,1,0),1,Color3.new(0.7,0.7,0.7),0,Enum.Font.GothamBold,13,"DEAD: "..p.Name espD[v]=b end end end end end end
	else for i,v in espD do pcall(function() v:Destroy() end) espD[i]=nil end end
	fovC.Visible,fovC.Radius,fovC.Position=showF,fovR,UIS:GetMouseLocation()
	if Lib.Flags.EnableFOV then
		if(isRightClickZooming and not fovZoomDisabled) or isK("ZoomKey") then cam.FieldOfView=Lib.Flags.ZoomFOV or 30 else cam.FieldOfView=Lib.Flags.CamFOV or 70 end
	end

	local curT=nil
	local shouldFreeze=shouldFreezeHRP()
	
	if Lib.Flags.AimbotToggle and isK("AimKey") then
		local t=getClst()
		if t and t.Character then
			curT=t
			local lerpA=sens<=0 and 1 or math.clamp(1-sens,0.01,1)
			if zeroAimVM and vmAimPart then
				local tp=t.Character:FindFirstChild(aimP) or t.Character:FindFirstChild("Torso")
				if tp then
					local vmCF=vmAimPart.CFrame
					local camCF=cam.CFrame
					local vmOffsetFromCam=camCF:ToObjectSpace(vmCF)
					local vmPos=vmOffsetFromCam.Position
					local correctedTarget=tp.Position-Vector3.new(vmPos.X,vmPos.Y,0)
					cam.CFrame=cam.CFrame:Lerp(CFrame.new(camCF.Position,correctedTarget),lerpA)
				end
			else
				local tp=t.Character:FindFirstChild(aimP) or t.Character:FindFirstChild("Torso")
				if tp then cam.CFrame=cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position,tp.Position),lerpA) end
			end
			if shouldFreeze and t.Character:FindFirstChild("HumanoidRootPart") then
				t.Character.HumanoidRootPart.Anchored=true
				frozenTarget=t
			end
		end
	end
	
	if not shouldFreeze then
		unanchorFrozen()
	elseif curT~=frozenTarget then
		unanchorFrozen()
	end
	
	lastTarget=curT

	if Lib.Flags.TriggerBot and(trigM=="Always Auto" or isK("TriggerKey")) then local t=mouse.Target if t and t.Parent then local c=t.Parent:IsA("Accessory") and t.Parent.Parent or t.Parent if c:FindFirstChild("Humanoid") and c~=lplr.Character and c.Humanoid.Health>0 then mouse1press() task.wait() mouse1release() end end end

	if espI and isK("InvKey") then
		local t=getClst()
		if t then
			if currentInvTarget~=t then currentInvTarget=t clrDrw() iChk=true end
			iChk=true
			local rd=RS:FindFirstChild("Players")
			local pinv=rd and rd:FindFirstChild(t.Name) and rd[t.Name]:FindFirstChild("Inventory")
			if pinv then if invImageMode then drawImageInv(pinv,t.Name) else drawTextInv(pinv,t.Name) end end
		else if iChk then iChk=false clrDrw() pcall(function() local g=lplr.PlayerGui:FindFirstChild("_InvImgGui") if g then g:Destroy() end end) end end
	else if iChk then iChk=false clrDrw() pcall(function() local g=lplr.PlayerGui:FindFirstChild("_InvImgGui") if g then g:Destroy() end end) end end

	if espP then for _,v in Plrs:GetPlayers() do if v~=lplr and v.Character then upEsp(v.Character,v.Name,Color3.new(1,0.2,0.2),espW) end end end
	if espA then
		local z=Work:FindFirstChild("AiZones")
		if z then local ig={HeliCrashClaymores=true,OutpostClaymores=true,OutpostLandmines=true,ShipWreckClaymores=true,BridgeClaymores=true} for _,f in z:GetChildren() do if not ig[f.Name] then for _,m in f:GetChildren() do if m:IsA("Model") and m:FindFirstChild("Humanoid") then upEsp(m,m.Name,Color3.new(1,1,0),false) end end end end end
	end
	for _,b in {{P="AiZones.Factory.Dozer",N="Dozer",K="Dozer"},{P="AiZones.Whisper.Whisper",N="Whisper",K="Whisper"},{P="AiZones.Sawmill.Anton",N="Anton",K="Anton"}} do
		local h,m=getB("workspace."..b.P)
		if m then if espB then upEsp(m,b.N,Color3.new(1,0.6,0),false) end if not bState[b.K] then bState[b.K]=true if Lib.Flags["Notif"..b.K] then Lib:Notify("BOSS",b.N.." Spawned!",5) end end else bState[b.K]=false end
	end
	local dH=getB("workspace.AiZones.Factory.Dozer") lD:Set(dH and(dH.Health>0 and "Dozer: "..math.floor(dH.Health) or "Dozer: DEAD") or "Dozer: Not Spawned")
	local wH=getB("workspace.AiZones.Whisper.Whisper") lW:Set(wH and(wH.Health>0 and "Whisper: "..math.floor(wH.Health) or "Whisper: DEAD") or "Whisper: Not Spawned")
	local aH=getB("workspace.AiZones.Sawmill.Anton") lA:Set(aH and(aH.Health>0 and "Anton: "..math.floor(aH.Health) or "Anton: DEAD") or "Anton: Not Spawned")
end)

