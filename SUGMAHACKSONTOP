					for _,a in ai do
						local aF=Instance.new("Frame",sf) aF.Size,aF.Position,aF.BackgroundColor3,aF.BackgroundTransparency,aF.BorderSizePixel=UDim2.new(0,16,0,16),UDim2.new(0,ax,0,sz-18),Color3.fromRGB(18,18,18),0.15,0
